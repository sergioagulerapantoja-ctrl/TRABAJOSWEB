@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    El entorno de <strong>desarrollo</strong> muestra información detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno de desarrollo no debe habilitarse en aplicaciones publicadas.</strong>
    Podría mostrar información sensible de las excepciones a los usuarios finales.
    Para depurar localmente, establezca la variable <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong>
    y reinicie la aplicación.
</p>
