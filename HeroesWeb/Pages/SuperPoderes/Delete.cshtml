@page
@model HeroesWeb.Pages_SuperPoderes.DeleteModel

@{
    ViewData["Title"] = "Eliminar superpoder";
}

<h1>Eliminar superpoder</h1>

<h3>¿Está seguro de que desea eliminar este superpoder?</h3>
<div>
    <h4>Superpoder</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SuperPoderes.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SuperPoderes.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SuperPoderes.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SuperPoderes.Descripcion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SuperPoderes.Heroe)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SuperPoderes.Heroe.Nombre)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="SuperPoderes.Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-page="./Index">Volver a la lista</a>
    </form>
</div>
