@page
@model HeroesWeb.Pages_Heroes.DeleteModel

@{
    ViewData["Title"] = "Eliminar héroe";
}

<h1>Eliminar héroe</h1>

<h3>¿Está seguro de que desea eliminar este héroe?</h3>
<div>
    <h4>Héroe</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Heroes.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Heroes.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Heroes.IdentidadSecreta)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Heroes.IdentidadSecreta)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Heroes.Ciudad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Heroes.Ciudad)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Heroes.Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-page="./Index">Volver a la lista</a>
    </form>
</div>
