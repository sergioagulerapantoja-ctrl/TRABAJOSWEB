@page
@model HeroesWeb.Pages_Heroes.IndexModel

@{
    ViewData["Title"] = "Héroes";
}

<h1>Héroes</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Crear nuevo héroe</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Heroes[0].Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Heroes[0].IdentidadSecreta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Heroes[0].Ciudad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Heroes) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdentidadSecreta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ciudad)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
