@page
@model HeroesWeb.Pages_Heroes.CreateModel

        @{
        ViewData["Title"] = "Crear héroe";
        }
        
        <h1>Crear héroe</h1>
        
    <h4>Héroe</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Heroes.Nombre" class="control-label"></label>
                <input asp-for="Heroes.Nombre" class="form-control" />
                <span asp-validation-for="Heroes.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroes.IdentidadSecreta" class="control-label"></label>
                <input asp-for="Heroes.IdentidadSecreta" class="form-control" />
                <span asp-validation-for="Heroes.IdentidadSecreta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroes.Ciudad" class="control-label"></label>
                <input asp-for="Heroes.Ciudad" class="form-control" />
                <span asp-validation-for="Heroes.Ciudad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
