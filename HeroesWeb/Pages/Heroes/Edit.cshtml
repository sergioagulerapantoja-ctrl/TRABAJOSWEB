@page
@model HeroesWeb.Pages_Heroes.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Heroes</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Heroes.Id" />
            <div class="form-group">
                <label asp-for="Heroes.Nombre" class="control-label"></label>
                <input asp-for="Heroes.Nombre" class="form-control" />
                <span asp-validation-for="Heroes.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroes.NombreReal" class="control-label"></label>
                <input asp-for="Heroes.NombreReal" class="form-control" />
                <span asp-validation-for="Heroes.NombreReal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroes.Universo" class="control-label"></label>
                <input asp-for="Heroes.Universo" class="form-control" />
                <span asp-validation-for="Heroes.Universo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroes.SuperPoderId" class="control-label"></label>
                <select asp-for="Heroes.SuperPoderId" class="form-control" asp-items="ViewBag.SuperPoderId" ></select>
                <span asp-validation-for="Heroes.SuperPoderId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
